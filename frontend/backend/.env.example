# Application Port (Render will inject its own PORT automatically)
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas Connection URI (Either MONGODB_URI or MONGO_URI can be used)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task_manager?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_uri_here
# MONGO_URI=your_mongodb_connection_uri_here

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection Pool & Timeout Settings (Optimized for Atlas M0 Free Tier)
MONGO_MAX_POOL_SIZE=5
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
